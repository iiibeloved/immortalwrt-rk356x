{
	"luci-app-menusort": {
		"description": "服务菜单排序（正向/反向）",
		"read": {
			"file": {
				"/usr/bin/luci-services-order": [ "exec" ],
				"/etc/luci-services-order.log": [ "read" ],
				"/usr/lib/lua/luci/controller/passwall.lua": [ "read" ],
				"/usr/share/luci/menu.d/luci-app-menusort.json": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/bin/luci-services-order": [ "exec" ]
			}
		}
	}
}
