#!/bin/sh
# =============================================================================
#  首启初始化状态自检：一条命令判断「脚本是否都跑完了」
#  用法: firstboot-status
#  退出码: 0=全部就绪  1=仍在进行(或有问题)
# =============================================================================
ok()   { printf '  \033[32m✅ %s\033[0m\n' "$1"; }
wait_() { printf '  \033[33m⏳ %s\033[0m\n' "$1"; }
bad()  { printf '  \033[31m❌ %s\033[0m\n' "$1"; }

READY=1
chk() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else wait_ "$1"; READY=0; fi; }

echo "==== 首启初始化状态 ===="
echo "[1/7] 数据盘挂载"
if awk '$2 ~ /^\/mnt\//' /proc/mounts | grep -q .; then
	ok "已挂载：$(awk '$2 ~ /^\/mnt\//{printf "%s ", $2}' /proc/mounts)"
else
	wait_ "没有 /mnt 挂载（本固件不自动分区；需要数据盘请手动挂载，见 build-guide 7.6）"
fi
echo "[2/7] eMMC 额外分区（可选）"
if grep -q "mmcblk0p5" /proc/partitions && grep -q "mmcblk0p6" /proc/partitions; then
	ok "已划分 p5(ext_relay) / p6(Data)"
else
	ok "未划分（可选；不需要就不管，不影响就绪判定）"
fi
echo "[3/7] 后台任务"
if pgrep -f 'mkfs|ha-config-path' >/dev/null 2>&1; then
	wait_ "仍有后台任务在跑（格式化/挂载中，请再等）"; READY=0
else ok "没有正在运行的初始化进程"; fi
echo "[4/7] 一次性脚本"
LEFT=$(ls /etc/uci-defaults/ 2>/dev/null | wc -l)
if [ "${LEFT:-0}" -eq 0 ]; then ok "uci-defaults 已全部执行并被删除"; else wait_ "还有 $LEFT 个一次性脚本未完成"; READY=0; fi
echo "[5/7] docker"
DROOT=$(docker info 2>/dev/null | awk -F': ' '/Docker Root Dir/{print $2}')
if printf '%s' "$DROOT" | grep -q '^/mnt/'; then ok "Docker Root Dir = $DROOT（已指向外挂盘）"
elif [ -n "$DROOT" ]; then wait_ "Docker Root Dir = $DROOT（仍在 overlay；需要时手动 uci set dockerd.globals.data_root）"; READY=0
else wait_ "dockerd 还没起来"; READY=0; fi
echo "[6/7] 其他服务"
HAP=$(uci -q get homeassistant.@homeassistant[0].config_path 2>/dev/null)
[ -n "$HAP" ] && ok "HA 配置路径 = $HAP" || { wait_ "HA 配置路径尚未写入"; READY=0; }
LANIP=$(uci -q get network.lan.ipaddr 2>/dev/null)
[ "$LANIP" = "192.168.100.1" ] && ok "LAN = $LANIP" || { wait_ "LAN 地址 = ${LANIP:-未知}"; READY=0; }
netstat -lnt 2>/dev/null | grep -q ':7681' && ok "TTYD 已在 7681 监听" || { wait_ "TTYD 未监听 7681"; READY=0; }
echo "[7/7] 软件源"
if [ -s /etc/opkg-boot.log ] && tail -5 /etc/opkg-boot.log | grep -q 'opkg update 成功'; then
	ok "opkg update 已成功（列表已就绪）"
elif [ -d /var/opkg-lists ] && [ "$(ls /var/opkg-lists 2>/dev/null | wc -l)" -ge 6 ]; then
	ok "已下载 $(ls /var/opkg-lists | wc -l) 个源的列表"
else wait_ "软件包列表未就绪（登录后「系统→软件包→刷新」，或查 /etc/opkg-boot.log）"; fi

echo
if [ "$READY" = "1" ]; then
	echo "==== 结论: 初始化已完成，可以开始配置 ===="
	exit 0
else
	echo "==== 结论: 仍在初始化（未标记的项目请再等 1–2 分钟；若超过 10 分钟仍如此，看对应日志）===="
	echo "常见日志: /etc/opkg-boot.log  /etc/ha-config.log  /etc/nvme-automount.log"
	exit 1
fi
