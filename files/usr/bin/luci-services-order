#!/bin/sh
# =============================================================================
#  统一「服务」菜单顺序
#
#  用法:
#    luci-services-order             # 正向：英文 A-Z → 中文拼音首字母
#    luci-services-order reverse     # 反向：中文倒序 → 英文倒序
#    luci-services-order forward     # 显式正向
#
#  覆盖两类来源:
#    - /usr/share/luci/menu.d/*.json 的 "admin/services/<app>" 节点（改 "order"）
#    - /usr/lib/lua/luci/controller/*.lua 的 entry({"admin","services","<app>"}, ..., N)
#  只处理顶层应用节点；子菜单不动。幂等，可重复执行。
#
#  日志: /etc/luci-services-order.log
# =============================================================================

MD=/usr/share/luci/menu.d
LC=/usr/lib/lua/luci/controller
LOG=/etc/luci-services-order.log
MODE="${1:-forward}"

log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }

patch_json() {   # $1=文件名  $2=app  $3=order
	f="$MD/$1"; [ -f "$f" ] || return 0
	awk -v k="\"admin/services/$2\": {" -v n="$3" '
		{ line=$0 }
		index(line, k) { inblk=1 }
		inblk && /"order"/ { sub(/"order"[ \t]*:[ \t]*-?[0-9]+/, "\"order\": " n); inblk=0 }
		{ print }
	' "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
}

patch_lua() {    # $1=文件名  $2=app  $3=order
	f="$LC/$1"; [ -f "$f" ] || return 0
	awk -v a="\"$2\"}" -v n="$3" '
		{
			line=$0
			if ((index(line, "\"services\", " a) || index(line, "\"services\"," a))) {
				last=-1; lastlen=0; pos=1; rest=line
				while ((r = match(rest, /,[ \t]*[0-9]+\)/)) > 0) {
					last = pos + r - 1; lastlen = RLENGTH
					pos = last + RLENGTH; rest = substr(line, pos)
				}
				if (last > 0)
					line = substr(line,1,last-1) ", " n ")" substr(line,last+lastlen)
			}
			print line
		}
	' "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
}

apply_one() {    # $1=app  $2=order
	f=$(ls "$MD"/luci-app-*.json 2>/dev/null | xargs grep -l "\"admin/services/$1\": {" 2>/dev/null | head -1)
	if [ -n "$f" ]; then
		patch_json "$(basename "$f")" "$1" "$2"
	else
		patch_lua "$1.lua" "$1" "$2"
	fi
}

EN="ddns-go dockermanager fastnet homeassistant homebox homeproxy kaiplus istoreenhance lucky navidrome openclash passwall upnp"
ZH="baidudrive nlbw ddns floatip ksgc emmc-health lan-wake lan-scanner ksmbd wol wolplus appfilter linkeasefull"

case "$MODE" in
	reverse)
		# 中文倒序 → 英文倒序
		LIST=""
		for a in $ZH; do LIST="$a $LIST"; done
		for a in $EN; do LIST="$a $LIST"; done
		;;
	*)
		LIST="$EN $ZH"
		;;
esac

o=10
n=0
for a in $LIST; do
	apply_one "$a" "$o"
	o=$((o + 10)); n=$((n + 1))
done

# 特例：passwall.lua 用变量 appname，order 需单独改
pw="$LC/passwall.lua"
if [ -f "$pw" ] && grep -q 'services", appname}' "$pw"; then
	pwo=120
	[ "$MODE" = "reverse" ] && pwo=$(( (n - 3) * 10 + 10 ))   # 反向时放在英文段靠后
	sed -i "/services\", appname}/ s/,[[:space:]]*-\{0,1\}[0-9]\{1,\})/, $pwo)/" "$pw" 2>/dev/null
fi

rm -f /tmp/luci-indexcache* 2>/dev/null
log "菜单排序已执行：mode=$MODE 应用数=$n"
echo "mode=$MODE apps=$n"
exit 0
