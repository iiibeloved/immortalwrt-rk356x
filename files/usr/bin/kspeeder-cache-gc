#!/bin/sh
# =============================================================================
#  KSpeeder（iStore 增强）缓存回收
#
#  KSpeeder 把 docker 镜像层缓存在 $cache 目录（uci istoreenhance.*.cache），
#  长期拉镜像会持续增长。本脚本在缓存超过阈值时调用 `ks-cli cache clean`，
#  未超阈值则跳过（避免误删热缓存、影响加速效果）。
#
#  阈值：环境变量 KS_CACHE_LIMIT_MB（默认 2048 = 2 GiB）
#  日志：/etc/kspeeder-cache-gc.log
#  定时：/etc/crontabs/root 里 15 4 * * *（由 uci-defaults 98-docker-extras 写入）
# =============================================================================

CACHE=$(uci -q get istoreenhance.@istoreenhance[0].cache)
[ -n "$CACHE" ] || CACHE=/mnt/nvme0/Configs/iStoreEnhance
LIMIT_MB=${KS_CACHE_LIMIT_MB:-2048}
LOG=/etc/kspeeder-cache-gc.log

[ -d "$CACHE" ] || exit 0
command -v ks-cli >/dev/null 2>&1 || exit 0

used_kb=$(du -sk "$CACHE" 2>/dev/null | awk '{print $1}')
[ -n "$used_kb" ] || exit 0
used_mb=$((used_kb / 1024))

if [ "$used_mb" -gt "$LIMIT_MB" ]; then
	ks-cli cache clean >>"$LOG" 2>&1
	echo "$(date '+%F %T') 已清理（${used_mb}MB > ${LIMIT_MB}MB）" >> "$LOG"
else
	echo "$(date '+%F %T') 跳过（${used_mb}MB <= ${LIMIT_MB}MB）" >> "$LOG"
fi
