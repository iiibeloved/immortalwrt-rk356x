#!/bin/sh /etc/rc.common
# =============================================================================
#  把 docker 数据目录(dockerd.globals.data_root)落到外挂盘
#
#  背景: 默认 /opt/docker 位于 rootfs_data(overlay, 4096 MiB), 装几个镜像就满。
#  行为:
#    * 开机时探测 /mnt/* 下由块设备挂载的 ext4/btrfs/xfs/f2fs 分区(剩余 >= 8 GiB);
#      找到则把 data_root 设为 "<挂载点>/docker"
#    * 找不到则回退到 /opt/docker (默认值), 不会让 dockerd 起不来
#    * 若 data_root 已被用户手工改成别的路径, 则完全不动它
#    * 记录标记文件 /etc/.docker-dataroot, 便于识别"是我们设的"
#
#  指定固定盘: 在 /etc/config/dockerd 里手工把 data_root 设成目标路径即可,
#  之后本脚本不会再改(见下方"尊重用户设置"判断)。
# =============================================================================

START=60          # dockerd 是 START=99, 这里更早, 无需重启 docker
STOP=10

: "${MARKER:=/etc/.docker-dataroot}"
MIN_FREE_KB=$((8 * 1024 * 1024))    # 至少 8 GiB 可用

find_external_mount() {
	local mp dev fs avail
	for mp in $(awk '$2 ~ /^\/mnt\// {print $2}' /proc/mounts); do
		dev=$(awk -v m="$mp" '$2 == m {print $1; exit}' /proc/mounts)
		fs=$(awk -v m="$mp" '$2 == m {print $3; exit}' /proc/mounts)
		case "$dev" in
			/dev/mmcblk*|/dev/sd*|/dev/nvme*|/dev/vd*) ;;
			*) continue ;;
		esac
		case "$fs" in
			ext4|ext3|btrfs|xfs|f2fs) ;;
			*) continue ;;
		esac
		avail=$(df -Pk "$mp" 2>/dev/null | awk 'NR == 2 {print $4}')
		[ -n "$avail" ] && [ "$avail" -ge "$MIN_FREE_KB" ] || continue
		echo "$mp"
		return 0
	done
	return 1
}

start() {
	local mp target cur i

	# 等外挂盘挂上来(最多 60 秒)
	i=0
	while [ "$i" -lt 12 ]; do
		mp=$(find_external_mount) && break
		mp=""
		sleep 5
		i=$((i + 1))
	done

	cur=$(uci -q get dockerd.globals.data_root 2>/dev/null)
	case "$cur" in
		""|"/opt/docker"|"/opt/docker/") cur_is_default=1 ;;
		*) cur_is_default=0 ;;
	esac

	if [ -z "$mp" ]; then
		# 没有可用外挂盘: 若之前是我们设到外挂盘上的, 回退默认值
		if [ -f "$MARKER" ] && [ "$cur_is_default" = "0" ]; then
			uci -q set dockerd.globals.data_root="/opt/docker"
			uci -q commit dockerd
			rm -f "$MARKER"
			logger -t docker-dataroot "未找到外挂盘, data_root 回退到 /opt/docker"
		fi
		cur=$(uci -q get dockerd.globals.data_root 2>/dev/null)
		logger -t docker-dataroot "未找到可用外挂盘(>=8GiB), 当前 data_root=${cur:-/opt/docker}"
		return 0
	fi

	target="$mp/docker"

	# 尊重用户手工设置: 非默认值且不是我们上次设的路径 -> 不动
	if [ "$cur_is_default" = "0" ] && [ "$cur" != "$target" ]; then
		if [ "$(cat "$MARKER" 2>/dev/null)" != "$cur" ]; then
			logger -t docker-dataroot "data_root=$cur 为手工设置, 跳过自动调整"
			return 0
		fi
	fi

	[ "$cur" = "$target" ] && { logger -t docker-dataroot "data_root 已是 $target"; return 0; }

	mkdir -p "$target" || { logger -t docker-dataroot "创建 $target 失败"; return 0; }
	uci -q set dockerd.globals.data_root="$target" || return 0
	uci -q commit dockerd || return 0
	echo "$target" > "$MARKER"
	logger -t docker-dataroot "docker 数据目录 -> $target"
}

stop() { :; }
