#!/bin/sh /etc/rc.common
# =============================================================================
#  用前面板电源灯(led-power)指示初始化进度
#
#  状态:
#    快速闪烁(约 200ms)  = 正在初始化(挂载/格式化/一次性脚本/opkg 等还在跑)
#    常亮               = 初始化完成, 系统就绪
#    不亮               = 本脚本未运行(或硬件问题)
#
#  实现: 直接写 /sys/class/leds/<led>/brightness 翻转(不依赖 ledtrig-timer 模块,
#        本固件只带了 kmod-leds-gpio)。就绪后置 trigger=default-on + brightness=1。
#  超时: 最多闪烁 300 秒(避免无网络时 opkg 重试导致长时间闪烁)。
# =============================================================================

START=12           # 早期启动(晚于 procd, 早于大部分服务)
STOP=10

: "${LOG:=/etc/bootled.log}"
: "${MAX_BLINK_SEC:=300}"
: "${INTERVAL_MS:=200}"          # 闪烁半周期(毫秒)

log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }

find_led() {
	local l
	if [ -n "${BOOTLED_LED:-}" ] && [ -e "$BOOTLED_LED/brightness" ]; then
		echo "$BOOTLED_LED"; return 0
	fi
	# 优先用名为 led-power / power 的灯, 否则取第一个
	for l in /sys/class/leds/*; do
		[ -e "$l/brightness" ] || continue
		case "$(basename "$l")" in
			*power*|*Power*|led-power) echo "$l"; return 0 ;;
		esac
	done
	for l in /sys/class/leds/*; do
		[ -e "$l/brightness" ] && { echo "$l"; return 0; }
	done
	return 1
}

init_ready() {
	# 1) 一次性脚本已全部执行完(目录为空)
	if [ -d /etc/uci-defaults ]; then
		[ -z "$(ls -A /etc/uci-defaults 2>/dev/null)" ] || return 1
	fi
	# 2) 没有仍在跑的初始化进程
	pgrep -f 'mkfs|parted|ha-config-path|nvme-automount|opkg update' >/dev/null 2>&1 && return 1
	return 0
}

solid() {
	echo default-on > "$1/trigger" 2>/dev/null
	echo 1 > "$1/brightness" 2>/dev/null
}

start() {
	local led per_iter max_iter
	led=$(find_led) || { log "没有可用 LED, 跳过"; return 0; }
	echo none > "$led/trigger" 2>/dev/null
	echo 0 > "$led/brightness" 2>/dev/null
	log "开始指示: $led"

	# 每次迭代 = 亮 INTERVAL_MS + 灭 INTERVAL_MS
	per_iter=$((INTERVAL_MS * 2))
	max_iter=$(( MAX_BLINK_SEC * 1000 / per_iter ))
	[ "$max_iter" -gt 0 ] || max_iter=1

	(
		t=0
		while [ "$t" -lt "$max_iter" ]; do
			if init_ready; then
				solid "$led"
				log "初始化完成, 电源灯常亮"
				exit 0
			fi
			echo 1 > "$led/brightness" 2>/dev/null
			sleep "$(awk "BEGIN{printf \"%.3f\", $INTERVAL_MS/1000}")" 2>/dev/null || sleep 1
			echo 0 > "$led/brightness" 2>/dev/null
			sleep "$(awk "BEGIN{printf \"%.3f\", $INTERVAL_MS/1000}")" 2>/dev/null || sleep 1
			t=$((t + 1))
		done
		solid "$led"
		log "等待超时(${MAX_BLINK_SEC}s), 强制置常亮"
	) &
}

stop() {
	local led
	led=$(find_led) || return 0
	solid "$led"
}
