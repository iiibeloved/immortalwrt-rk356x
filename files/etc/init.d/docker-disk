#!/bin/sh /etc/rc.common
# =============================================================================
#  首次启动: 把镜像之外的剩余空间拆成两块, 自动格式化并挂载
#
#    p5 (逻辑, 20 GiB)  ext4  LABEL=ext_relay  -> /mnt/ext_relay  docker 数据目录
#    p6 (逻辑, 其余)    ext4  LABEL=Data       -> /mnt/data       共享盘
#
#  MBR 约束: 镜像已用 3 个主分区(kernel/rootfs/rootfs_data), 主分区只剩 1 个槽位,
#  因此两块新盘放在一个扩展分区(p4)里的两个逻辑分区(p5/p6)。
#
#  安全:
#    * 只从最后一个分区的末尾往后追加, 绝不动 p1~p3
#    * 剩余空间 < 28 GiB 时不动作(小卡/已分区设备)
#    * 已存在 LABEL=ext_relay / LABEL=Data 的分区时只挂载, 不重新格式化
#    * 任一步失败都打日志并保留默认 /opt/docker, 不影响开机
#    * 成功后写 /etc/.docker-disk.done, 之后不再执行
#
#  开关:  touch /etc/.docker-disk.done 即关闭
#  重跑:  rm -f /etc/.docker-disk.done && /etc/init.d/docker-disk start
#  日志:  /etc/.docker-disk.log ; logread | grep docker-disk
# =============================================================================

START=58           # 早于 docker-dataroot(60) 与 dockerd(99)
STOP=10

: "${MARKER:=/etc/.docker-disk.done}"
: "${LOG:=/etc/.docker-disk.log}"
: "${BLOCKDIR:=/sys/class/block}"
: "${MOUNTS:=/proc/mounts}"
DRYRUN="${DOCKER_DISK_DRYRUN:-0}"

DOCKER_MIB=51200            # 50 GiB 给 docker
DOCKER_LABEL=ext_relay
DOCKER_MP=/mnt/ext_relay
DATA_LABEL=Data
DATA_MP=/mnt/data
MIN_DATA_MIB=8192           # Data 至少 8 GiB
MIN_FREE_MIB=$(( DOCKER_MIB + MIN_DATA_MIB ))   # 需 50 GiB + 8 GiB 才动手

log() { echo "$(date '+%F %T') $*" >> "$LOG"; logger -t docker-disk "$*" 2>/dev/null; }

boot_disk() {
	# 注意: ImmortalWrt 里 /rom 常显示为 /dev/root（squashfs 的虚拟设备名），
	# 必须先 readlink -f 解析成真实分区(如 /dev/mmcblk0p2)，否则在 sysfs 里查不到父磁盘。
	local part real sys
	part=$(awk '$2 == "/rom" {print $1; exit}' "$MOUNTS")
	[ -n "$part" ] || part=$(awk '$2 == "/overlay" {print $1; exit}' "$MOUNTS")
	[ -n "$part" ] || return 1

	real=$(readlink -f "$part" 2>/dev/null) || real="$part"
	for cand in "$real" "$part"; do
		sys="$BLOCKDIR/$(basename "$cand")"
		[ -e "$sys" ] || [ -L "$sys" ] || continue
		basename "$(readlink -f "$sys/..")"
		return 0
	done

	# 兜底: 让 lsblk 解析软链并取父磁盘名
	if command -v lsblk >/dev/null 2>&1; then
		local pk
		pk=$(lsblk -no PKNAME "$part" 2>/dev/null | head -1 | tr -d ' \n')
		[ -n "$pk" ] && { echo "$pk"; return 0; }
	fi
	return 1
}

disk_size_bytes() { echo $(( $(cat "$BLOCKDIR/$1/size") * 512 )); }

last_part_end_bytes() {
	local d="$1" max=0 p sz start end
	for p in "$BLOCKDIR/$d"/*/partition; do
		[ -e "$p" ] || continue
		sz=$(cat "${p%/partition}/size")
		start=$(cat "${p%/partition}/start")
		end=$(( (start + sz) * 512 ))
		[ "$end" -gt "$max" ] && max=$end
	done
	echo "$max"
}

disk_major() { cut -d: -f1 "$BLOCKDIR/$1/dev"; }

fstype_of() { blkid -s TYPE -o value "$1" 2>/dev/null || blkid "$1" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p'; }

label_of() { blkid 2>/dev/null | awk -v l="LABEL=\"$1\"" 'index($0, l) {print $1; exit}'; }
uuid_of()  { blkid "$1" 2>/dev/null | sed -n 's/.* UUID="\([^"]*\)".*/\1/p'; }

mknode() {   # $1=devname  $2=minor
	local dev="/dev/$1"
	[ -b "$dev" ] && return 0
	[ "$DRYRUN" = "1" ] && { log "[dryrun] mknod $dev b $(disk_major "$DISK") $2"; return 0; }
	mknod "$dev" b "$(disk_major "$DISK")" "$2" 2>>"$LOG"
}

fmt_mount() {   # $1=devname  $2=minor  $3=label  $4=mountpoint  $5=docker?
	local dev="/dev/$1" uuid
	mknode "$1" "$2" || { log "mknod $1 失败"; return 1; }
	if [ -n "$(fstype_of "$dev")" ]; then
		log "$dev 已有文件系统 $(fstype_of "$dev"), 跳过格式化"
	elif [ "$DRYRUN" = "1" ]; then
		log "[dryrun] mkfs.ext4 -F -m 0 -L $3 $dev ; mount $dev $4"
	else
		mkfs.ext4 -F -m 0 -L "$3" -E lazy_itable_init=1,discard "$dev" >>"$LOG" 2>&1 \
			|| mkfs.ext4 -F -m 0 -L "$3" "$dev" >>"$LOG" 2>&1 \
			|| { log "格式化 $dev 失败"; return 1; }
	fi
	[ "$DRYRUN" = "1" ] || mkdir -p "$4"
	if [ "$DRYRUN" != "1" ]; then
		mountpoint -q "$4" || mount -t ext4 "$dev" "$4" || { log "挂载 $dev -> $4 失败"; return 1; }
	fi
	uuid=$(uuid_of "$dev")
	[ -n "$uuid" ] || uuid=""
	if [ "$DRYRUN" = "1" ]; then
		log "[dryrun] fstab uuid=${uuid:-?} -> $4"
	elif [ -n "$uuid" ] && uci -q show fstab 2>/dev/null | grep -q "\.uuid='$uuid'"; then
		log "$4 已在 fstab 中(uuid=$uuid), 不重复写入"
	else
		uci -q add fstab mount >/dev/null
		uci -q set "fstab.@mount[-1].uuid=$uuid"
		uci -q set "fstab.@mount[-1].target=$4"
		uci -q set "fstab.@mount[-1].fstype=ext4"
		uci -q set "fstab.@mount[-1].options=noatime"
		uci -q set "fstab.@mount[-1].enabled=1"
		uci -q commit fstab
	fi
	if [ "$5" = "docker" ]; then
		[ "$DRYRUN" = "1" ] || mkdir -p "$4/docker"
	fi
	return 0
}

set_docker_root() {
	local cur
	cur=$(uci -q get dockerd.globals.data_root 2>/dev/null)
	case "$cur" in
		""|"/opt/docker"|"/opt/docker/") ;;
		*) log "data_root 已是 $cur (手工设置), 不改"; return 0 ;;
	esac
	[ "$DRYRUN" = "1" ] || ln -sfn "$DOCKER_MP/docker" /opt/docker 2>/dev/null
	if [ "$DRYRUN" = "1" ]; then
		log "[dryrun] dockerd.data_root=$DOCKER_MP/docker"
		return 0
	fi
	uci -q set dockerd.globals.data_root="$DOCKER_MP/docker"
	uci -q commit dockerd
	/etc/init.d/dockerd restart >/dev/null 2>&1
	log "dockerd data_root -> $DOCKER_MP/docker"
}

start() {
	[ -f "$MARKER" ] && return 0
	if command -v flock >/dev/null 2>&1; then
		exec 9>/tmp/docker-disk.lock 2>/dev/null
		flock -n 9 || { log "已有实例在运行, 跳过"; return 0; }
	fi

	DISK=$(boot_disk 2>/dev/null || true)
	[ -n "$DISK" ] || DISK="${BOOT_DISK:-}"
	[ -n "$DISK" ] || { log "找不到启动盘, 跳过"; return 0; }

	local size end free_mib start_mib dev

	size=$(disk_size_bytes "$DISK" 2>/dev/null || echo 0)
	if [ "${size:-0}" -le 0 ]; then
		log "无法读取 $DISK 的容量(/sys/class/block/$DISK/size), 放弃"
		return 0
	fi

	# 已存在两块盘: 只挂载
	if [ -n "$(label_of "$DOCKER_LABEL")" ] && [ -n "$(label_of "$DATA_LABEL")" ]; then
		log "已存在 LABEL=$DOCKER_LABEL / $DATA_LABEL, 只挂载"
		dev=$(label_of "$DOCKER_LABEL"); [ "$DRYRUN" = "1" ] || mkdir -p "$DOCKER_MP"
		[ "$DRYRUN" = "1" ] || { mountpoint -q "$DOCKER_MP" || mount -t ext4 "$dev" "$DOCKER_MP"; }
		dev=$(label_of "$DATA_LABEL"); [ "$DRYRUN" = "1" ] || mkdir -p "$DATA_MP"
		[ "$DRYRUN" = "1" ] || { mountpoint -q "$DATA_MP" || mount -t ext4 "$dev" "$DATA_MP"; }
		set_docker_root
		return 0
	fi

	end=$(last_part_end_bytes "$DISK")
	free_mib=$(( (size - end) / 1048576 ))
	log "启动盘 /dev/$DISK 总 $((size/1073741824)) GiB, 已用 $((end/1073741824)) GiB, 剩余 ${free_mib} MiB"

	# 上次中途失败留下的 p5/p6: 不改动分区表, 直接复用(已格式化则只挂载)
	if [ -e "$BLOCKDIR/$DISK/${DISK}p5" ] && [ -e "$BLOCKDIR/$DISK/${DISK}p6" ]; then
		log "$DISK 已存在 p5/p6, 跳过分区创建, 直接复用"
		fmt_mount "${DISK}p5" 5 "$DOCKER_LABEL" "$DOCKER_MP" docker || { return 0; }
		fmt_mount "${DISK}p6" 6 "$DATA_LABEL"   "$DATA_MP"   || { return 0; }
		set_docker_root
		[ "$DRYRUN" = "1" ] || touch "$MARKER"
		log "复用完成: ${DISK}p5 -> $DOCKER_MP, ${DISK}p6 -> $DATA_MP"
		return 0
	fi

	if [ "$free_mib" -lt "$MIN_FREE_MIB" ]; then
		log "剩余不足 ${MIN_FREE_MIB} MiB (需 $((DOCKER_MIB/1024)) GiB docker + $((MIN_DATA_MIB/1024)) GiB Data), 不建分区"
		return 0
	fi

	start_mib=$(( (end + 1048575) / 1048576 + 1 ))     # 向上取整到 MiB +1 对齐

	if [ "$DRYRUN" = "1" ]; then
		log "[dryrun] parted -s /dev/$DISK unit MiB mkpart extended ${start_mib} 100%"
		log "[dryrun] parted -s /dev/$DISK unit MiB mkpart logical ext4 ${start_mib} $((start_mib + DOCKER_MIB - 1))MiB"
		log "[dryrun] parted -s /dev/$DISK unit MiB mkpart logical ext4 $((start_mib + DOCKER_MIB)) 100%"
	else
		parted -s "/dev/$DISK" unit MiB mkpart extended "${start_mib}MiB" 100% >>"$LOG" 2>&1 \
			|| { log "创建扩展分区失败, 放弃"; return 0; }
		parted -s "/dev/$DISK" unit MiB mkpart logical ext4 "${start_mib}MiB" "$((start_mib + DOCKER_MIB - 1))MiB" >>"$LOG" 2>&1 \
			|| { log "创建 docker 逻辑分区失败, 放弃"; return 0; }
		parted -s "/dev/$DISK" unit MiB mkpart logical ext4 "$((start_mib + DOCKER_MIB))MiB" 100% >>"$LOG" 2>&1 \
			|| { log "创建 Data 逻辑分区失败, 放弃"; return 0; }
	fi

	# 在线改分区表后内核通常不会立刻生成新分区节点(mknod 出来的节点无法 mkfs/mount),
	# 检测不到就让系统重启一次; 下次开机走上面「已存在 p5/p6」的复用分支继续格式化。
	if [ "$DRYRUN" != "1" ] && [ ! -e "$BLOCKDIR/${DISK}p5" ]; then
		if [ -f /etc/.docker-disk.rebooted ]; then
			log "重启后仍未识别 ${DISK}p5, 放弃自动处理(请手动 parted/mkfs 或反馈)"
			return 0
		fi
		log "内核尚未识别新分区, 写入重启标记并重启一次(下次开机继续格式化)"
		touch /etc/.docker-disk.rebooted
		sync
		reboot
		return 0
	fi

	# MBR 逻辑分区从 5 号开始
	fmt_mount "${DISK}p5" 5 "$DOCKER_LABEL" "$DOCKER_MP" docker || { rm -f "$MARKER"; return 0; }
	fmt_mount "${DISK}p6" 6 "$DATA_LABEL"   "$DATA_MP"   || { rm -f "$MARKER"; return 0; }
	set_docker_root
	[ "$DRYRUN" = "1" ] || { touch "$MARKER"; rm -f /etc/.docker-disk.rebooted; }
	log "完成: ${DISK}p5($DOCKER_LABEL) -> $DOCKER_MP, ${DISK}p6($DATA_LABEL) -> $DATA_MP"
}

stop() { :; }
