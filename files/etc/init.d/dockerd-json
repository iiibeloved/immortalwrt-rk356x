#!/bin/sh /etc/rc.common
# =============================================================================
#  生成 docker 守护进程配置（解决这个固件的两个坑）
#
#  坑 1：/etc/init.d/dockerd 用的是 DOCKER_CONF_DIR=/tmp/dockerd，
#        每次启动都会 rm -rf 并**按 uci 重写** daemon.json，
#        因此放在 /etc/docker/daemon.json 的日志轮转配置永远不生效。
#  坑 2：init 只支持 log-driver，不支持 log-opts（max-size/max-file）。
#
#  本脚本(早于 dockerd 的 START=99 执行):
#    1) 从 uci 读 dockerd.globals.data_root（默认 /opt/docker）；
#    2) 生成 /etc/dockerd-custom.json（在 /etc/docker 和 /tmp/dockerd 之外，不会被清理），
#       内容含 data-root + json-file 日志轮转；
#    3) 把 dockerd.globals.alt_config_file 指向它 → dockerd init 会软链到
#       /tmp/dockerd/daemon.json 并跳过重写；
#    4) 若 data_root 落在 overlay/tmpfs 上，写告警日志（这种目录只能用 vfs）。
#
#  日志: /etc/dockerd-json.log
# =============================================================================

START=98
STOP=10

: "${LOG:=/etc/dockerd-json.log}"
: "${CUSTOM_JSON:=/etc/dockerd-custom.json}"
: "${MAX_SIZE:=10m}"
: "${MAX_FILE:=3}"

log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }

fstype_of_dir() {
	local p="$1"
	while [ -n "$p" ] && [ ! -d "$p" ]; do p=$(dirname "$p"); done
	stat -f -c %T "$p" 2>/dev/null || echo unknown
}

start() {
	local root fs

	root=$(uci -q get dockerd.globals.data_root 2>/dev/null)
	[ -n "$root" ] || root="/opt/docker"

	# 目录存在性（不创建：创建在 overlay 上也没意义，但 dockerd 自己会创建）
	mkdir -p "$root" 2>/dev/null || true

	fs=$(fstype_of_dir "$root")
	case "$fs" in
		overlay|overlayfs|tmpfs|ramfs)
			log "⚠️ data_root=$root 位于 $fs 文件系统：docker 只能退回 vfs（每层完整复制，极易写满）。"
			log "   请把 data_root 指到真实块设备挂载点（ext4/xfs/btrfs/f2fs），例如 /mnt/nvme0/docker 或 /mnt/data/docker。"
			;;
		*) log "data_root=$root 文件系统=$fs（可支持 overlay2）" ;;
	esac

	# 生成自定义 daemon 配置
	{
		printf '{\n'
		printf '  "data-root": "%s",\n' "$root"
		printf '  "log-driver": "json-file",\n'
		printf '  "log-opts": { "max-size": "%s", "max-file": "%s" }\n' "$MAX_SIZE" "$MAX_FILE"
		printf '}\n'
	} > "$CUSTOM_JSON" 2>/dev/null || { log "写 $CUSTOM_JSON 失败"; return 0; }

	# 指向它（alt_config_file 生效后，init 会跳过 data-root 的 uci 读取，数据以本文件为准）
	if [ "$(uci -q get dockerd.globals.alt_config_file 2>/dev/null)" != "$CUSTOM_JSON" ]; then
		uci -q set "dockerd.globals.alt_config_file=$CUSTOM_JSON"
		uci -q commit dockerd
		log "已设置 dockerd.globals.alt_config_file=$CUSTOM_JSON"
	fi

	log "配置已生成: $CUSTOM_JSON（data-root=$root, log-opts=$MAX_SIZE x $MAX_FILE）"
}

stop() { :; }
