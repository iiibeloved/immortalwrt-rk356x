#!/bin/sh
# =============================================================================
#  启用并首次执行内置的 init 脚本（bootled / nvme-automount / ha-config-path）。
#
#  背景: 仅把脚本放进 /etc/init.d/ 不会开机自启, 必须在 /etc/rc.d/ 下创建
#        S<优先级><名字> 符号链接(即 `init.d 脚本 enable`)。本文件在首次启动时
#        被 uci-defaults 机制自动执行, 负责 enable 并立刻跑一遍(否则要等下次重启)。
# =============================================================================
LOG=/etc/custom-initd.log
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

for s in bootled nvme-automount ha-config-path; do
	[ -x "/etc/init.d/$s" ] || { log "缺少 /etc/init.d/$s"; continue; }
	/etc/init.d/"$s" enable >/dev/null 2>&1 && log "已 enable $s" || log "enable $s 失败"
done
ls -l /etc/rc.d/ 2>/dev/null | grep -E 'bootled|nvme-automount|ha-config-path' >> "$LOG" 2>&1

# 首次启动立即执行一遍(不用等重启)。放后台, 避免格式化 250 GiB 分区拖慢开机。
(
	sleep 5
	for s in bootled nvme-automount ha-config-path; do
		[ -x "/etc/init.d/$s" ] || continue
		log "首次执行 $s"
		/etc/init.d/"$s" start >> "$LOG" 2>&1
	done
	# HA 配置路径依赖外挂盘, 再等一会儿
	sleep 15
	[ -x /etc/init.d/ha-config-path ] && /etc/init.d/ha-config-path start >> "$LOG" 2>&1
	sync
) &

# 让 block 重新读取 fstab(把新写入的挂载点立刻挂上)
[ -x /etc/init.d/fstab ] && /etc/init.d/fstab restart >/dev/null 2>&1
sync
exit 0
