# =============================================================================
#  ttyd 终端配置
#
#  关键点: 不要设置 option interface (上游默认是 '@lan')。
#  init 脚本会把它翻成 `ttyd -i <网卡>`, 使 ttyd 绑定到该网卡"启动瞬间"的地址;
#  之后修改 LAN 管理地址(或换网段、改 br-lan IP), 监听 socket 仍停在旧地址,
#  浏览器访问新地址就报「已拒绝连接」。留空 = 监听 0.0.0.0:7681, 任何已放行的
#  网段都能连, 改 IP 也不受影响。
#
#  需要的字段(其余用上游默认):
#    port     监听端口, 默认 7681
#    command  登录后执行的命令
#    enable   1=随开机启动
# =============================================================================
config ttyd
	option enable '1'
	option port '7681'
	option command '/bin/login'
	# option interface '@lan'      # ← 保持注释! 绑定网卡会导致改 IP 后连不上
	# option readonly '1'          # 需要只读终端时打开
	# option ssl '1'               # 需要 HTTPS 终端时打开(配合证书)
