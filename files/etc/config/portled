# =============================================================================
#  指示灯配置
#
#  本机指示灯分两类:
#    1) GPIO 灯: 前面板电源灯 led-power (GPIO0_C4) —— 由内核 gpio-leds 驱动。
#       结论: 保持常亮即可, 关闭它没有实际意义(不省电、也不影响任何功能),
#       因此不再提供关闭开关; /etc/init.d/portled 每次开机确保它处于常亮状态。
#    2) RJ45 网口灯: 由 Realtek RTL8367S 交换芯片硬件驱动, 软件无法控制
#       (rtl8367b 驱动未暴露 LED 属性), 详见 docs/build-guide.md 7.11。
# =============================================================================
config portled 'main'
	# 保留该段仅为兼容旧配置(旧版本有 enable/power_led 开关);
	# 新逻辑忽略这些值, 电源灯固定常亮。
	option mode 'on'
